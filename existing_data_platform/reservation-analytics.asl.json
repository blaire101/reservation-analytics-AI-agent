{
  "Comment": "At 02:30 Singapore time, verify upstream DWD/DIM partitions for the same business date, then run DM and ADS.",
  "StartAt": "Prepare Runtime Input",
  "States": {
    "Prepare Runtime Input": {
      "Type": "Pass",
      "Comment": "The scheduled EventBridge event fires at 18:30 UTC, which is 02:30 Singapore time on the next calendar day. The UTC date is therefore used as the previous Singapore business date.",
      "Parameters": {
        "business_date.$": "States.ArrayGetItem(States.StringSplit($.time, 'T'), 0)",
        "attempt": 0,
        "readiness": {}
      },
      "Next": "Check DWD Reservation Partition"
    },
    "Check DWD Reservation Partition": {
      "Type": "Task",
      "Resource": "arn:${AWSPartition}:states:::aws-sdk:glue:getPartitions",
      "Parameters": {
        "DatabaseName": "${UpstreamDwdDatabase}",
        "TableName": "${DwdReservationTableName}",
        "Expression.$": "States.Format('business_date=\\'{}\\'', $.business_date)",
        "MaxResults": 1
      },
      "ResultPath": "$.readiness.dwd_reservation",
      "Next": "Is DWD Reservation Ready"
    },
    "Is DWD Reservation Ready": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.readiness.dwd_reservation.Partitions[0]",
          "IsPresent": true,
          "Next": "Check DWD Paid Order Partition"
        }
      ],
      "Default": "Increment Readiness Attempt"
    },
    "Check DWD Paid Order Partition": {
      "Type": "Task",
      "Resource": "arn:${AWSPartition}:states:::aws-sdk:glue:getPartitions",
      "Parameters": {
        "DatabaseName": "${UpstreamDwdDatabase}",
        "TableName": "${DwdPaidOrderTableName}",
        "Expression.$": "States.Format('business_date=\\'{}\\'', $.business_date)",
        "MaxResults": 1
      },
      "ResultPath": "$.readiness.dwd_paid_order",
      "Next": "Is DWD Paid Order Ready"
    },
    "Is DWD Paid Order Ready": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.readiness.dwd_paid_order.Partitions[0]",
          "IsPresent": true,
          "Next": "Check DIM Campaign Partition"
        }
      ],
      "Default": "Increment Readiness Attempt"
    },
    "Check DIM Campaign Partition": {
      "Type": "Task",
      "Resource": "arn:${AWSPartition}:states:::aws-sdk:glue:getPartitions",
      "Parameters": {
        "DatabaseName": "${UpstreamDimDatabase}",
        "TableName": "${DimCampaignTableName}",
        "Expression.$": "States.Format('business_date=\\'{}\\'', $.business_date)",
        "MaxResults": 1
      },
      "ResultPath": "$.readiness.dim_campaign",
      "Next": "Is DIM Campaign Ready"
    },
    "Is DIM Campaign Ready": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.readiness.dim_campaign.Partitions[0]",
          "IsPresent": true,
          "Next": "Run DM Conversion"
        }
      ],
      "Default": "Increment Readiness Attempt"
    },
    "Increment Readiness Attempt": {
      "Type": "Pass",
      "Parameters": {
        "business_date.$": "$.business_date",
        "attempt.$": "States.MathAdd($.attempt, 1)",
        "readiness.$": "$.readiness"
      },
      "Next": "Readiness Timeout?"
    },
    "Readiness Timeout?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.attempt",
          "NumericGreaterThanEquals": 24,
          "Next": "Upstream Readiness Timed Out"
        }
      ],
      "Default": "Wait for Upstream"
    },
    "Wait for Upstream": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "Check DWD Reservation Partition"
    },
    "Run DM Conversion": {
      "Type": "Task",
      "Resource": "arn:${AWSPartition}:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${DmConversionJobName}",
        "Arguments": {
          "--BUSINESS_DATE.$": "$.business_date"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.dm_error",
          "Next": "Workflow Failed"
        }
      ],
      "Next": "Run ADS Jobs"
    },
    "Run ADS Jobs": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Run ADS Campaign",
          "States": {
            "Run ADS Campaign": {
              "Type": "Task",
              "Resource": "arn:${AWSPartition}:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "${AdsCampaignJobName}",
                "Arguments": {
                  "--BUSINESS_DATE.$": "$.business_date"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "Run ADS CRM",
          "States": {
            "Run ADS CRM": {
              "Type": "Task",
              "Resource": "arn:${AWSPartition}:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "${AdsCrmJobName}",
                "Arguments": {
                  "--BUSINESS_DATE.$": "$.business_date"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 30,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.ads_error",
          "Next": "Workflow Failed"
        }
      ],
      "Next": "Workflow Succeeded"
    },
    "Workflow Succeeded": {
      "Type": "Succeed"
    },
    "Upstream Readiness Timed Out": {
      "Type": "Fail",
      "Error": "UpstreamReadinessTimeout",
      "Cause": "Required DWD/DIM partitions were not ready within approximately two hours."
    },
    "Workflow Failed": {
      "Type": "Fail",
      "Error": "ReservationAnalyticsPipelineFailed",
      "Cause": "A DM or ADS Glue job failed after retry."
    }
  }
}
